{
  "asr": {
    "sample_rate": 16000,
    "pad_sec": 0.4,
    "peak_normalize": 0.9,
    "beam_size": 5,
    "models": {
      "whisper": {
        "kind": "faster-whisper",
        "name": "medium",
        "compute_type": "int8"
      },
      "breeze": {
        "kind": "ct2-dir",
        "path": ".cache/breeze-ct2-int8",
        "hf_repo": "MediaTek-Research/Breeze-ASR-25",
        "compute_type": "int8"
      }
    },
    "use_aux_prompt": false,
    "aux_prompt": "以下是繁體中文的普通話。"
  },
  "credit": {
    "exact": 1.0,
    "loose": 0.75,
    "tone_diff": 0.4,
    "loose_tone_diff": 0.25
  },
  "score": {
    "asr_ok": 0.8,
    "asr_bad": 0.5,
    "tone_bad_ratio_suspect": 0.5,
