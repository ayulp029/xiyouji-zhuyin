    "symbol_wrong_all_fail": true,
    "symbol_wrong_any_suspect": true,
    "agreed_error_suspect": true,
    "any_asr_error_suspect": false
  },
  "tone": {
    "trim_frac": 0.12,
    "min_voiced_frames": 6,
    "flat_max_abs_delta_st": 2.5,
    "rise_min_delta_st": 1.0,
    "fall_max_delta_st": -2.0,
    "t3_max_delta_st": 2.5,
    "t3_dip_min_st": 1.5,
    "enabled": true,
    "max_syllables": 2
  }
